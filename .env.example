# Shared infra config (postgres/openfga containers themselves, and the
# one-off `pnpm --filter @qislearn/authz authz:setup` script). Per-app
# runtime config lives in apps/api/.env / apps/web/.env instead — copy
# those from their own .env.example files too.
POSTGRES_USER=qislearn
POSTGRES_PASSWORD=qislearn
POSTGRES_DB=qislearn
POSTGRES_PORT=5432

OPENFGA_POSTGRES_DB=openfga
OPENFGA_API_PORT=8080
OPENFGA_PLAYGROUND_PORT=3000
OPENFGA_API_URL=http://localhost:8080

# Used by docker-compose's api/web services to chown their bind-mounted
# node_modules back to you after `pnpm install` runs as root in-container
# (see docker-compose.yml). Uncomment and set to `id -u`/`id -g` on your
# host if not 1001:1001.
# HOST_UID=1000
# HOST_GID=1000
