# Server-side (loaders, build scripts). Default already matches
# host-based dev; docker-compose overrides this to the container-internal
# http://api:4000/graphql for the containerized `web` service.
QISLEARN_API_URL=http://localhost:4000/graphql

# Client-side (browser) — must be VITE_-prefixed to reach import.meta.env,
# and must always resolve from the user's machine (never the docker-internal
# `api` hostname), so this stays http://localhost:4000/graphql in every case.
VITE_API_URL=http://localhost:4000/graphql
