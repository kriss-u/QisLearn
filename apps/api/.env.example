PORT=4000
DATABASE_URL=postgres://qislearn:qislearn@localhost:5432/qislearn
BETTER_AUTH_SECRET=change-me-32-chars-minimum-please
BETTER_AUTH_URL=http://localhost:4000
# Browser origin allowed to call this API with credentials (CORS). Always
# localhost:5173 regardless of Docker vs host dev — the browser never
# reaches the container-internal `web` hostname, same reasoning as
# apps/web's VITE_API_URL.
WEB_URL=http://localhost:5173

OPENFGA_API_URL=http://localhost:8080
# Filled in after running `pnpm --filter @qislearn/authz authz:setup`
OPENFGA_STORE_ID=
OPENFGA_MODEL_ID=

# "Ask about this lesson" panel (apps/api/src/lesson-qa.ts). Optional: with
# no key, the ask mutations fail with a clear error instead of crashing the
# API. Get a key at https://openrouter.ai/keys.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
